<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#E3162A" /><corners android:radius="6dp" /></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="#66000000" /><stroke android:width="2dp" android:color="#F0C45C" /><corners android:radius="6dp" /></shape>
    </item>
    <item><shape><solid android:color="#38000000" /><corners android:radius="6dp" /></shape></item>
</selector>

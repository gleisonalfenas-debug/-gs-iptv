<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#262B36" /><stroke android:width="3dp" android:color="#FFFFFF" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:state_activated="true">
        <layer-list>
            <item><shape><solid android:color="#1E222B" /><corners android:radius="10dp" /></shape></item>
            <item android:gravity="start|fill_vertical" android:width="4dp"><shape><solid android:color="#E3162A" /><corners android:radius="2dp" /></shape></item>
        </layer-list>
    </item>
    <item><shape><solid android:color="#171A21" /><corners android:radius="12dp" /></shape></item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#40000000" /><stroke android:width="3dp" android:color="#F0C45C" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:state_selected="true">
        <shape><solid android:color="#2E000000" /><stroke android:width="2dp" android:color="#F0C45C" /><corners android:radius="12dp" /></shape>
    </item>
    <item><shape><solid android:color="#00000000" /><corners android:radius="12dp" /></shape></item>
</selector>

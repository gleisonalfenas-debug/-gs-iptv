<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="when_playing" />

    <!-- Logo 3D pequeno fixo + relógio (opcional) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.gs.iptv.Logo3DView
            android:id="@+id/cornerLogo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:alpha="0.85" />

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_dark_box"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Aviso do canal: nome + velocidade (some depois de 10s) -->
    <LinearLayout
        android:id="@+id/osd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="32dp"
        android:background="@drawable/bg_dark_box"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingVertical="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/osdName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="560dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/osdInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Conectando…"
            android:textColor="@color/gold"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- Filmes/séries: idioma, legenda e resolução (seta para baixo) -->
    <LinearLayout
        android:id="@+id/trackPanel"
        android:layout_width="620dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:background="@drawable/bg_dark_box"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Opções do filme"
            android:textColor="@color/gold"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rowAudio"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_item"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/rowText"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_item"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/rowVideo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_item"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/trackHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="▲▼ escolhe a opção  ·  ◀ ▶ troca  ·  Voltar fecha"
            android:textColor="@color/pink_text"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Lista de canais (OK) e categorias (seta esquerda) -->
    <LinearLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_overlay"
        android:orientation="horizontal"
        android:paddingVertical="28dp"
        android:paddingStart="28dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/catBox"
            android:layout_width="250dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Categorias"
                android:textColor="@color/gold"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.gs.iptv.TvList
                android:id="@+id/catList"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="420dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Canais"
                android:textColor="@color/gold"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.gs.iptv.TvList
                android:id="@+id/chList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="◀ Categorias  ·  OK assistir  ·  Voltar fecha"
                android:textColor="@color/pink_text"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main">

    <!-- Globo terrestre 3D girando no fundo -->
    <com.gs.iptv.GlobeView
        android:id="@+id/bgLogo"
        android:layout_width="600dp"
        android:layout_height="600dp"
        android:layout_gravity="center"
        android:alpha="0.30" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingTop="18dp"
        android:paddingBottom="24dp">

    <!-- Topo: logo, ícones e relógio -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_logo" />

        <TextView
            android:id="@+id/brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="GS IPTV"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnSearch"
            style="@style/GS.IconButton"
            android:contentDescription="Buscar"
            android:src="@drawable/ic_search" />

        <ImageButton
            android:id="@+id/btnSend"
            style="@style/GS.IconButton"
            android:contentDescription="Enviar lista pelo celular"
            android:src="@drawable/ic_phone" />

        <ImageButton
            android:id="@+id/btnRefresh"
            style="@style/GS.IconButton"
            android:contentDescription="Atualizar lista"
            android:src="@drawable/ic_refresh" />

        <ImageButton
            android:id="@+id/btnAccount"
            style="@style/GS.IconButton"
            android:contentDescription="Minha conta"
            android:src="@drawable/ic_user" />

        <ImageButton
            android:id="@+id/btnSettings"
            style="@style/GS.IconButton"
            android:contentDescription="Configurações"
            android:src="@drawable/ic_settings" />

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:textColor="@color/pink_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Abas -->
    <LinearLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1">

        <!-- TV ao vivo -->
        <LinearLayout
            android:id="@+id/liveView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <com.gs.iptv.TvList
                android:id="@+id/liveCategories"
                android:layout_width="260dp"
                android:layout_height="match_parent" />

            <com.gs.iptv.TvList
                android:id="@+id/channels"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Filmes / Séries / Kids / Anime -->
        <LinearLayout
            android:id="@+id/vodView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.gs.iptv.TvList
                android:id="@+id/vodCategories"
                android:layout_width="260dp"
                android:layout_height="match_parent" />

            <com.gs.iptv.TvList
                android:id="@+id/vodSimple"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/fanBox"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:orientation="vertical">

                <com.gs.iptv.CardFan
                    android:id="@+id/cardFan"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipChildren="false" />

                <TextView
                    android:id="@+id/vodTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/vodMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/pink_text"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button"
                    android:paddingHorizontal="26dp"
                    android:paddingVertical="10dp"
                    android:text="▶  OK para assistir"
                    android:textColor="#3A2400"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Início em fileiras -->
        <LinearLayout
            android:id="@+id/homeView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/hero"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:background="@drawable/bg_dark_box">

                <ImageView
                    android:id="@+id/heroImage"
                    android:layout_width="360dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_hero_fade" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingHorizontal="28dp">

                    <TextView
                        android:id="@+id/heroKind"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.2"
                        android:textColor="@color/gold"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/heroTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="360dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/heroMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/pink_text"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_button"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="6dp"
                        android:text="▶  OK para assistir"
                        android:textColor="#3A2400"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/homeRows"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:clipToPadding="false" />
        </LinearLayout>

        <!-- Jogos do dia -->
        <LinearLayout
            android:id="@+id/gamesView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jogos de hoje"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/gamesDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:textColor="@color/pink_text"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OK no jogo = assistir ou agendar"
                    android:textColor="@color/pink_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.gs.iptv.TvList
                android:id="@+id/gamesList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Destaques em espiral -->
        <LinearLayout
            android:id="@+id/highlightView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <com.gs.iptv.SpiralView
                android:id="@+id/spiral"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/hlTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hlMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="◀ ▶ gira a espiral · OK assistir"
                android:textColor="@color/pink_text"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="@color/pink_text"
            android:textSize="20sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/sectionPanel"
            android:layout_width="680dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_dark_box"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Escolha o que baixar"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/panelHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"
                android:text="Baixe uma parte de cada vez para a TV não travar."
                android:textColor="@color/pink_text"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="10dp"
                android:background="#33000000"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Canais ao vivo"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statusLive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="18dp"
                    android:textColor="@color/pink_text"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnLive"
                    android:layout_width="150dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_button"
                    android:text="Baixar"
                    android:textAllCaps="false"
                    android:textColor="#3A2400"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="10dp"
                android:background="#33000000"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Filmes"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statusMovie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="18dp"
                    android:textColor="@color/pink_text"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnMovie"
                    android:layout_width="150dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_button"
                    android:text="Baixar"
                    android:textAllCaps="false"
                    android:textColor="#3A2400"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="10dp"
                android:background="#33000000"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Séries"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statusSeries"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="18dp"
                    android:textColor="@color/pink_text"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnSeries"
                    android:layout_width="150dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_button"
                    android:text="Baixar"
                    android:textAllCaps="false"
                    android:textColor="#3A2400"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_dark_box"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:indeterminateTint="@color/gold" />

            <TextView
                android:id="@+id/loadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Carregando lista…"
                android:textSize="18sp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="OK = assistir · Segure OK = favorito"
        android:textColor="@color/pink_text"
        android:textSize="13sp" />
</LinearLayout>
</FrameLayout>

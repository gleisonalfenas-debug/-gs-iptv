<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111318"
    android:orientation="horizontal">

    <!-- Barra lateral -->
    <LinearLayout
        android:id="@+id/rail"
        android:layout_width="84dp"
        android:layout_height="match_parent"
        android:background="#0B0C10"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="20dp">


    </LinearLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Cabeçalho -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingHorizontal="28dp"
                android:paddingTop="20dp"
                android:paddingBottom="12dp">

                <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="26sp" android:textStyle="bold" />
                <TextView android:id="@+id/subtitle" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="1"
                    android:textColor="#8B8F9C" android:textSize="15sp" />
                <TextView android:id="@+id/version" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp" android:textColor="#5C6070" android:textSize="12sp" />
                <TextView android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="18sp" android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- INÍCIO -->
                <ScrollView android:id="@+id/pageHome" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scrollbars="none" android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:paddingHorizontal="28dp" android:paddingBottom="20dp">

                        <FrameLayout android:id="@+id/hero" android:layout_width="match_parent" android:layout_height="210dp"
                            android:background="@drawable/bg_card" android:focusable="true" android:foreground="@drawable/bg_focus_ring">
                            <ImageView android:id="@+id/heroImg" android:layout_width="match_parent" android:layout_height="match_parent"
                                android:importantForAccessibility="no" android:scaleType="centerCrop" />
                            <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_hero_dark" />
                            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical"
                                android:orientation="vertical" android:paddingHorizontal="26dp">
                                <TextView android:id="@+id/heroKind" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:letterSpacing="0.15" android:text="LANÇAMENTO" android:textColor="@color/gold" android:textSize="13sp" android:textStyle="bold" />
                                <TextView android:id="@+id/heroTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                                    android:layout_marginEnd="300dp" android:ellipsize="end" android:maxLines="1" android:textSize="38sp" android:textStyle="bold" />
                                <TextView android:id="@+id/heroMeta" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:textColor="#D0D3DB" android:textSize="15sp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                                    android:background="@drawable/bg_white_btn" android:paddingHorizontal="18dp" android:paddingVertical="8dp"
                                    android:text="▶  Assistir" android:textColor="#111318" android:textSize="15sp" android:textStyle="bold" />
                            </LinearLayout>
                        </FrameLayout>

                        <TextView android:id="@+id/contTitle" style="@style/GS.RowTitle" android:text="Continuar assistindo" />
                        <com.gs.iptv.HRow android:id="@+id/contRow" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:clipToPadding="false" android:paddingVertical="6dp" />

                        <TextView android:id="@+id/newTitle" style="@style/GS.RowTitle" android:text="Filmes · lançamentos" />
                        <com.gs.iptv.HRow android:id="@+id/newRow" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:clipToPadding="false" android:paddingVertical="6dp" />

                        <TextView android:id="@+id/seriesTitle" style="@style/GS.RowTitle" android:text="Séries · lançamentos" />
                        <com.gs.iptv.HRow android:id="@+id/seriesRow" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:clipToPadding="false" android:paddingVertical="6dp" />

                        <TextView android:id="@+id/kidsTitle" style="@style/GS.RowTitle" android:text="Kids · lançamentos" />
                        <com.gs.iptv.HRow android:id="@+id/kidsRow" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:clipToPadding="false" android:paddingVertical="6dp" />
                        <TextView android:id="@+id/favTitle" style="@style/GS.RowTitle" android:text="Canais favoritos" />
                        <com.gs.iptv.HRow android:id="@+id/favRow" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:clipToPadding="false" android:paddingVertical="6dp" />

                    </LinearLayout>
                </ScrollView>

                <!-- TV AO VIVO -->
                <LinearLayout android:id="@+id/pageTv" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="horizontal" android:visibility="gone">

                    <com.gs.iptv.TvList android:id="@+id/tvCats" android:layout_width="220dp" android:layout_height="match_parent"
                        android:background="#14161C" android:clipToPadding="false" android:paddingHorizontal="10dp" android:paddingVertical="8dp" />

                    <com.gs.iptv.TvList android:id="@+id/tvList" android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:clipToPadding="false" android:paddingHorizontal="18dp" android:paddingVertical="8dp" />

                    <LinearLayout android:id="@+id/infoPanel" android:layout_width="320dp" android:layout_height="match_parent"
                        android:background="@drawable/bg_info_panel" android:orientation="vertical" android:padding="24dp">
                        <FrameLayout android:layout_width="96dp" android:layout_height="96dp" android:background="@drawable/bg_card">
                            <TextView android:id="@+id/infoInitials" android:layout_width="match_parent" android:layout_height="match_parent"
                                android:gravity="center" android:textSize="30sp" android:textStyle="bold" />
                            <ImageView android:id="@+id/infoLogo" android:layout_width="match_parent" android:layout_height="match_parent"
                                android:importantForAccessibility="no" android:padding="10dp" android:scaleType="fitCenter" />
                        </FrameLayout>
                        <TextView android:id="@+id/infoName" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="14dp" android:ellipsize="end" android:maxLines="2" android:textSize="24sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                            android:background="@drawable/bg_live" android:paddingHorizontal="8dp" android:paddingVertical="2dp"
                            android:text="AO VIVO" android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:id="@+id/infoProg" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="14dp" android:ellipsize="end" android:maxLines="2" android:textSize="19sp" android:textStyle="bold" />
                        <TextView android:id="@+id/infoTime" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:textColor="#B9BDC8" android:textSize="14sp" />
                        <TextView android:id="@+id/infoNext" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:textColor="#8B8F9C" android:textSize="14sp" />
                        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:background="@drawable/bg_white_btn" android:gravity="center" android:paddingVertical="11dp"
                            android:text="OK  ▶  Assistir" android:textColor="#111318" android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                            android:background="@drawable/bg_card" android:gravity="center" android:paddingVertical="10dp"
                            android:text="Segure OK  ★  Favoritar" android:textColor="#D0D3DB" android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- FILMES / SÉRIES -->
                <LinearLayout android:id="@+id/pageVod" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:paddingHorizontal="20dp" android:visibility="gone">
                    <com.gs.iptv.HRow android:id="@+id/chips" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:clipToPadding="false" android:paddingHorizontal="8dp" android:paddingVertical="6dp" />
                    <com.gs.iptv.TvList android:id="@+id/vodGrid" android:layout_width="match_parent" android:layout_height="0dp"
                        android:layout_weight="1" android:clipToPadding="false" android:paddingVertical="6dp" />
                </LinearLayout>

                <!-- JOGOS -->
                <LinearLayout android:id="@+id/pageGames" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="vertical" android:paddingHorizontal="20dp" android:visibility="gone">
                    <com.gs.iptv.HRow android:id="@+id/dayChips" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:clipToPadding="false" android:paddingHorizontal="8dp" android:paddingVertical="6dp" />
                    <com.gs.iptv.TvList android:id="@+id/gamesList" android:layout_width="match_parent" android:layout_height="0dp"
                        android:layout_weight="1" android:clipToPadding="false" android:paddingHorizontal="8dp" android:paddingVertical="8dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                        android:layout_marginBottom="12dp" android:text="OK no jogo: assistir agora ou agendar (o canal abre 5 minutos antes)"
                        android:textColor="#8B8F9C" android:textSize="14sp" />
                </LinearLayout>

                <!-- KIDS -->
                <LinearLayout android:id="@+id/pageKids" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@drawable/bg_kids" android:orientation="vertical" android:paddingHorizontal="20dp" android:visibility="gone">
                    <TextView android:id="@+id/kidsBadge" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="8dp" android:layout_marginTop="4dp" android:background="@drawable/bg_safe_badge"
                        android:paddingHorizontal="12dp" android:paddingVertical="4dp" android:text="Modo seguro ligado"
                        android:textColor="#06261A" android:textSize="13sp" android:textStyle="bold" android:visibility="gone" />
                    <com.gs.iptv.TvList android:id="@+id/kidsGrid" android:layout_width="match_parent" android:layout_height="0dp"
                        android:layout_weight="1" android:clipToPadding="false" android:paddingVertical="8dp" />
                </LinearLayout>

                <!-- CONTA -->
                <LinearLayout android:id="@+id/pageAccount" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="horizontal" android:paddingHorizontal="28dp" android:paddingBottom="20dp" android:visibility="gone">
                    <LinearLayout android:id="@+id/accInfo" android:layout_width="420dp" android:layout_height="match_parent" android:orientation="vertical" />
                    <ScrollView android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="30dp"
                        android:layout_weight="1" android:scrollbars="none">
                        <LinearLayout android:id="@+id/accPrefs" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>
                </LinearLayout>

                <!-- Painel para baixar cada parte (primeira vez) -->
                <LinearLayout android:id="@+id/sectionPanel" android:layout_width="640dp" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:background="@drawable/bg_card" android:orientation="vertical"
                    android:padding="28dp" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Escolha o que baixar"
                        android:textSize="26sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                        android:layout_marginBottom="8dp" android:text="Baixe uma parte de cada vez para a TV não travar."
                        android:textColor="#8B8F9C" android:textSize="16sp" />
                    <LinearLayout style="@style/GS.PanelRow"><TextView style="@style/GS.PanelLabel" android:text="Canais ao vivo" />
                        <TextView android:id="@+id/statusLive" style="@style/GS.PanelStatus" /><Button android:id="@+id/btnLive" style="@style/GS.PanelBtn" /></LinearLayout>
                    <LinearLayout style="@style/GS.PanelRow"><TextView style="@style/GS.PanelLabel" android:text="Filmes" />
                        <TextView android:id="@+id/statusMovie" style="@style/GS.PanelStatus" /><Button android:id="@+id/btnMovie" style="@style/GS.PanelBtn" /></LinearLayout>
                    <LinearLayout style="@style/GS.PanelRow"><TextView style="@style/GS.PanelLabel" android:text="Séries" />
                        <TextView android:id="@+id/statusSeries" style="@style/GS.PanelStatus" /><Button android:id="@+id/btnSeries" style="@style/GS.PanelBtn" /></LinearLayout>
                </LinearLayout>

                <TextView android:id="@+id/empty" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:gravity="center" android:textColor="#B9BDC8" android:textSize="19sp" android:visibility="gone" />

                <LinearLayout android:id="@+id/loading" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:background="@drawable/bg_card" android:gravity="center_horizontal"
                    android:orientation="vertical" android:padding="24dp" android:visibility="gone">
                    <ProgressBar android:layout_width="52dp" android:layout_height="52dp" android:indeterminateTint="#E3162A" />
                    <TextView android:id="@+id/loadingText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:textSize="17sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>

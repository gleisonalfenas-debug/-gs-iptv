<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GS" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_main</item>
        <item name="android:windowFullscreen">true</item>
        <item name="colorPrimary">@color/red</item>
        <item name="colorPrimaryDark">@color/red_deep</item>
        <item name="colorAccent">@color/gold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
    </style>
    <style name="GS.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/red</item>
    </style>
    <style name="GS.Step">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="GS.IconButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:background">@drawable/bg_icon_btn</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:focusable">true</item>
    </style>
</resources>

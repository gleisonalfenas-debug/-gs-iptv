<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GS" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_main</item>
        <item name="android:windowFullscreen">true</item>
        <item name="colorPrimary">@color/red</item>
        <item name="colorPrimaryDark">@color/red_deep</item>
        <item name="colorAccent">@color/gold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
    </style>
    <style name="GS.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/red</item>
    </style>
    <style name="GS.Step" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="GS.IconButton" parent="">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:background">@drawable/bg_icon_btn</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="GS.RowTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
    <style name="GS.PanelRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">62dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">#1E222B</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>
    <style name="GS.PanelLabel" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
    <style name="GS.PanelStatus" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#8B8F9C</item>
    </style>
    <style name="GS.PanelBtn" parent="">
        <item name="android:layout_width">140dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:text">Baixar</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#3A2400</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
